      "concepts": ["TaskContext::goto", "task entry", "stack alignment", "first schedule"],
      "files": ["kernel/src/task/mod.rs"],
      "symptoms": ["ra-zero", "sp-not-aligned", "Lab5-T1-missing", "first-switch-failure"],
