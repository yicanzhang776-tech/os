@@ -107,8 +108,23 @@ impl Schedule<ProcId> for ProcManager {
         self.ready_queue.push_back(id);
     }

-    /// 从就绪队列头部取出下一个要执行的进程
+    /// Selects the runnable process with the smallest stride.
     fn fetch(&mut self) -> Option<ProcId> {
-        self.ready_queue.pop_front()
+        const BIG_STRIDE: usize = 65_536;
+
+        let mut selected = 0;
+        for index in 1..self.ready_queue.len() {
+            let candidate = self.tasks.get(&self.ready_queue[index])?.stride;
+            let current = self.tasks.get(&self.ready_queue[selected])?.stride;
+            // The signed wrapping difference preserves ordering across overflow
+            // while runnable strides remain within half the integer range.
+            if (candidate.wrapping_sub(current) as isize) < 0 {
+                selected = index;
+            }
+        }
+        let id = self.ready_queue.remove(selected)?;
+        let process = self.tasks.get_mut(&id)?;
+        process.stride = process.stride.wrapping_add(BIG_STRIDE / process.priority);
+        Some(id)
     }
 }
