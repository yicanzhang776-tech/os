@@ -47,6 +47,7 @@ impl Processor {

     /// 获取内部 PManager 的可变引用
     #[inline]
+    #[allow(clippy::mut_from_ref)]
     pub fn get_mut(&self) -> &mut PManager<Process, ProcManager> {
         unsafe { &mut (*self.inner.get()) }
