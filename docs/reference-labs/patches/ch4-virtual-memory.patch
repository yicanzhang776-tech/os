+/// Number of syscall counters retained for each process.
+pub const SYSCALL_COUNT_LIMIT: usize = 500;
+
 /// 进程结构体
 ///
 /// 包含进程运行所需的全部信息：
@@ -49,6 +53,7 @@ pub struct Process {
     pub heap_bottom: usize,
     /// 当前程序 break 位置（堆顶）
