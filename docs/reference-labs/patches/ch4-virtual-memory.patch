+    syscall_counts: Box<[usize]>,
 }

 impl Process {
@@ -150,9 +155,22 @@ impl Process {
             address_space,
             heap_bottom,
             program_brk: heap_bottom,
+            syscall_counts: alloc::vec![0; SYSCALL_COUNT_LIMIT].into_boxed_slice(),
         })
     }

+    /// Records one invocation when the syscall number is in the retained range.
+    pub fn record_syscall(&mut self, id: usize) {
+        if let Some(count) = self.syscall_counts.get_mut(id) {
+            *count += 1;
+        }
+    }
+
+    /// Returns the retained invocation count for a syscall number.
+    pub fn syscall_count(&self, id: usize) -> Option<usize> {
+        self.syscall_counts.get(id).copied()
+    }
+
     /// 修改程序 break 位置（实现 sbrk 系统调用）。
