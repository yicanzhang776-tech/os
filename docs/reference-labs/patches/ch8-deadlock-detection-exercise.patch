+/// Result of checking a resource acquisition request.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum AcquireResult {
+    /// The resource can be assigned immediately.
+    Granted,
+    /// The state is safe, but the resource is currently unavailable.
+    Wait,
+    /// Granting or waiting for the resource would make the state unsafe.
+    Deadlock,
+    /// The requested resource identifier does not exist.
+    Invalid,
+}
+
+/// Per-process state used by the deadlock safety algorithm.
+pub struct ResourceTracker {
+    available: Vec<usize>,
+    allocation: BTreeMap<usize, Vec<usize>>,
+    request: BTreeMap<usize, Vec<usize>>,
+}
+
+impl ResourceTracker {
+    /// Create an empty resource tracker.
+    pub fn new() -> Self {
+        Self {
+            available: Vec::new(),
+            allocation: BTreeMap::new(),
+            request: BTreeMap::new(),
+        }
+    }
+
+    /// Register or replace a resource class at the syscall-visible identifier.
+    pub fn register_resource(&mut self, resource: usize, count: usize) {
+        if self.available.len() <= resource {
+            self.available.resize(resource + 1, 0);
+        }
+        self.available[resource] = count;
+        for row in self
+            .allocation
+            .values_mut()
+            .chain(self.request.values_mut())
+        {
+            if row.len() <= resource {
+                row.resize(resource + 1, 0);
+            }
+            row[resource] = 0;
+        }
+    }
+
+    fn row_mut(
+        rows: &mut BTreeMap<usize, Vec<usize>>,
+        tid: usize,
+        width: usize,
+    ) -> &mut Vec<usize> {
+        let row = rows.entry(tid).or_insert_with(|| vec![0; width]);
+        if row.len() < width {
+            row.resize(width, 0);
+        }
+        row
+    }
+
+    /// Record a request and determine whether it may proceed safely.
+    pub fn acquire(&mut self, tid: usize, resource: usize, detect: bool) -> AcquireResult {
+        if resource >= self.available.len() {
+            return AcquireResult::Invalid;
+        }
+        let width = self.available.len();
+        let granted = self.available[resource] > 0;
+        if granted {
+            self.available[resource] -= 1;
+            Self::row_mut(&mut self.allocation, tid, width)[resource] += 1;
+        } else {
+            Self::row_mut(&mut self.request, tid, width)[resource] += 1;
+        }
+
+        if detect && !self.is_safe() {
+            if granted {
+                Self::row_mut(&mut self.allocation, tid, width)[resource] -= 1;
+                self.available[resource] += 1;
+            } else {
+                Self::row_mut(&mut self.request, tid, width)[resource] -= 1;
+            }
+            AcquireResult::Deadlock
+        } else if granted {
+            AcquireResult::Granted
+        } else {
+            AcquireResult::Wait
+        }
+    }
+
+    /// Undo a tracker change if the underlying primitive disagrees.
+    pub fn rollback(&mut self, tid: usize, resource: usize, result: AcquireResult) {
+        let width = self.available.len();
+        match result {
+            AcquireResult::Granted => {
+                let row = Self::row_mut(&mut self.allocation, tid, width);
+                if row[resource] > 0 {
+                    row[resource] -= 1;
+                    self.available[resource] += 1;
+                }
+            }
+            AcquireResult::Wait => {
+                let row = Self::row_mut(&mut self.request, tid, width);
+                if row[resource] > 0 {
+                    row[resource] -= 1;
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// Record a release and optional direct transfer to a waiting thread.
+    pub fn release(&mut self, tid: usize, resource: usize, waking: Option<usize>) {
+        if resource >= self.available.len() {
+            return;
+        }
+        let width = self.available.len();
+        let allocation = Self::row_mut(&mut self.allocation, tid, width);
+        if allocation[resource] > 0 {
+            allocation[resource] -= 1;
+        }
+        if let Some(waking) = waking {
+            let request = Self::row_mut(&mut self.request, waking, width);
+            if request[resource] > 0 {
+                request[resource] -= 1;
+            }
+            Self::row_mut(&mut self.allocation, waking, width)[resource] += 1;
+        } else {
+            self.available[resource] += 1;
+        }
+    }
+
+    /// Return whether the current allocation/request state is safe.
+    pub fn is_safe(&self) -> bool {
+        let mut tids: Vec<usize> = self
+            .allocation
+            .keys()
+            .chain(self.request.keys())
+            .copied()
+            .collect();
+        tids.sort_unstable();
+        tids.dedup();
+
+        let mut work = self.available.clone();
+        let mut finished = vec![false; tids.len()];
+        loop {
+            let mut progress = false;
+            for (index, tid) in tids.iter().enumerate() {
+                if finished[index] {
+                    continue;
+                }
+                let request = self.request.get(tid);
+                let can_finish = (0..work.len()).all(|resource| {
+                    request
+                        .and_then(|row| row.get(resource))
+                        .copied()
+                        .unwrap_or(0)
+                        <= work[resource]
+                });
+                if can_finish {
+                    if let Some(allocation) = self.allocation.get(tid) {
+                        for (resource, count) in allocation.iter().enumerate() {
+                            work[resource] += count;
+                        }
+                    }
+                    finished[index] = true;
+                    progress = true;
+                }
+            }
+            if !progress {
+                break;
+            }
+        }
+        finished.into_iter().all(|done| done)
+    }
+}
