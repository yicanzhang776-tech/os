diff --git a/tg-rcore-tutorial-ch6/src/processor.rs b/tg-rcore-tutorial-ch6/src/processor.rs
index a4bb41f..9f06db2 100644
--- a/tg-rcore-tutorial-ch6/src/processor.rs
+++ b/tg-rcore-tutorial-ch6/src/processor.rs
@@ -79,8 +79,23 @@ impl Schedule<ProcId> for ProcManager {
     fn add(&mut self, id: ProcId) {
         self.ready_queue.push_back(id);
     }
-    /// 从就绪队列头部取出
+    /// Select the runnable process with the smallest stride.
     fn fetch(&mut self) -> Option<ProcId> {
-        self.ready_queue.pop_front()
+        const BIG_STRIDE: usize = 65_536;
+
+        let mut selected = 0;
+        for index in 1..self.ready_queue.len() {
+            let candidate = self.tasks.get(&self.ready_queue[index])?.stride;
+            let current = self.tasks.get(&self.ready_queue[selected])?.stride;
+            if (candidate.wrapping_sub(current) as isize) < 0 {
+                selected = index;
+            }
+        }
+        let id = self.ready_queue.remove(selected)?;
+        let process = self.tasks.get_mut(&id)?;
+        process.stride = process
+            .stride
+            .wrapping_add(BIG_STRIDE / process.priority);
+        Some(id)
     }
 }
