+                return (None, None, 0);
+            }
+            let file_count = root_inode.size as usize / DIRENT_SZ;
+            let mut source_id = None;
+            let mut empty_slot = None;
+            let mut entry = DirEntry::empty();
+            for index in 0..file_count {
+                root_inode.read_at(index * DIRENT_SZ, entry.as_bytes_mut(), &self.block_device);
+                match entry.name() {
+                    name if name == dst => return (None, None, file_count),
+                    name if name == src => source_id = Some(entry.inode_number()),
+                    "" if empty_slot.is_none() => empty_slot = Some(index),
+                    _ => {}
+                }
+            }
+            (source_id, empty_slot, file_count)
+        });
+        let Some(source_id) = source_id else {
+            return -1;
+        };
+        let (source_block, source_offset) = fs.get_disk_inode_pos(source_id);
+        let linked = get_block_cache(source_block as usize, Arc::clone(&self.block_device))
+            .lock()
+            .modify(source_offset, |inode: &mut DiskInode| {
+                if inode.is_dir() || inode.nlink == u32::MAX {
+                    false
+                } else {
+                    inode.nlink += 1;
+                    true
+                }
+            });
+        if !linked {
+            return -1;
+        }
+        self.modify_disk_inode(|root_inode| {
+            let slot = empty_slot.unwrap_or(file_count);
+            if slot == file_count {
+                self.increase_size(((file_count + 1) * DIRENT_SZ) as u32, root_inode, &mut fs);
+            }
+            let entry = DirEntry::new(dst, source_id);
+            root_inode.write_at(slot * DIRENT_SZ, entry.as_bytes(), &self.block_device);
+        });
+        block_cache_sync_all();
+        0
+    }
+
+    /// Remove a directory entry and reclaim its inode after the final link.
+    pub fn unlink(&self, path: &str) -> isize {
+        if path.is_empty() {
+            return -1;
+        }
+        let mut fs = self.fs.lock();
+        let target = self.read_disk_inode(|root_inode| {
+            let file_count = root_inode.size as usize / DIRENT_SZ;
+            let mut entry = DirEntry::empty();
+            for index in 0..file_count {
+                root_inode.read_at(index * DIRENT_SZ, entry.as_bytes_mut(), &self.block_device);
+                if entry.name() == path {
+                    return Some((index, entry.inode_number()));
+                }
+            }
+            None
+        });
+        let Some((slot, inode_id)) = target else {
+            return -1;
+        };
+        let (block_id, block_offset) = fs.get_disk_inode_pos(inode_id);
+        let result = get_block_cache(block_id as usize, Arc::clone(&self.block_device))
+            .lock()
+            .modify(block_offset, |inode: &mut DiskInode| {
+                if inode.nlink == 0 || inode.is_dir() {
+                    return None;
+                }
+                inode.nlink -= 1;
+                let blocks = if inode.nlink == 0 {
+                    inode.clear_size(&self.block_device)
+                } else {
+                    Vec::new()
+                };
+                Some((inode.nlink == 0, blocks))
+            });
+        let Some((reclaim_inode, blocks)) = result else {
+            return -1;
+        };
+        self.modify_disk_inode(|root_inode| {
+            root_inode.write_at(
+                slot * DIRENT_SZ,
+                DirEntry::empty().as_bytes(),
+                &self.block_device,
+            );
+        });
+        if reclaim_inode {
+            for data_block in blocks {
+                fs.dealloc_data(data_block);
+            }
+            fs.dealloc_inode(inode_id);
+        }
+        block_cache_sync_all();
+        0
+    }
 }
