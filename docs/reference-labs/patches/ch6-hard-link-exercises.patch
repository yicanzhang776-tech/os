     /// 可写权限标志
     const WRITEABLE: VmFlags<Sv39> = build_flags("W_V");

+    fn read_user_bytes(process: &ProcStruct, address: usize, count: usize) -> Option<Vec<u8>> {
+        if count > 256 {
+            return None;
+        }
+        let mut bytes = Vec::with_capacity(count);
+        for offset in 0..count {
+            let address = address.checked_add(offset)?;
+            let ptr = process
+                .address_space
+                .translate::<u8>(VAddr::new(address), READABLE)?;
+            bytes.push(unsafe { *ptr.as_ptr() });
+        }
+        Some(bytes)
+    }
+
+    fn read_user_string(process: &ProcStruct, address: usize) -> Option<String> {
+        let mut bytes = Vec::new();
+        for offset in 0..256 {
+            let address = address.checked_add(offset)?;
+            let ptr = process
+                .address_space
+                .translate::<u8>(VAddr::new(address), READABLE)?;
+            let byte = unsafe { *ptr.as_ptr() };
+            if byte == 0 {
+                return String::from_utf8(bytes).ok();
+            }
+            bytes.push(byte);
+        }
+        None
+    }
+
+    fn write_user_stat(process: &ProcStruct, address: usize, stat: &Stat) -> Option<()> {
+        // SAFETY: Stat is a fully initialized #[repr(C)] value and the slice
+        // remains valid for the duration of this function.
+        let bytes = unsafe {
+            core::slice::from_raw_parts(
+                (stat as *const Stat).cast::<u8>(),
+                core::mem::size_of::<Stat>(),
+            )
+        };
+        for (offset, byte) in bytes.iter().enumerate() {
+            let address = address.checked_add(offset)?;
+            let mut destination = process
+                .address_space
+                .translate::<u8>(VAddr::new(address), WRITEABLE)?;
+            unsafe { *destination.as_mut() = *byte };
+        }
+        Some(())
+    }
+
